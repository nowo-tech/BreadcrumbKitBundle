{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
<div id="modal-bk-item-form-container">
{{ form_start(form, { attr: { class: 'bk-dashboard-form' } }) }}
    <input type="hidden" name="_modal" value="1">
    {% for child in form %}
        {% if not child.rendered %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
    <div class="{{ ui.row_actions() }}" style="justify-content:flex-start;margin-top:1rem;">
        <button type="submit" class="{{ ui.btn('primary') }}">{{ is_edit|default(false) ? ('dashboard.form_update'|trans) : ('dashboard.form_create'|trans) }}</button>
        <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans }}</button>
    </div>
{{ form_end(form) }}
</div>
