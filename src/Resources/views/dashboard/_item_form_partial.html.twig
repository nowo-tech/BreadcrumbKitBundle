{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _input = ui.input() %}
<div id="modal-bk-item-form-container">
{{ form_start(form, { attr: { class: 'bk-dashboard-form' } }) }}
    <input type="hidden" name="_modal" value="1">
    {{ form_row(form.routeName, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.staticRouteParams, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input ~ ' font-monospace', rows: 3, spellcheck: 'false' } }) }}
    {{ form_row(form.dynamicParamKeys, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input ~ ' font-monospace', rows: 2, spellcheck: 'false' } }) }}
    {{ form_row(form.linkEnabled, { label_attr: { class: 'form-check-label' }, row_attr: { class: 'form-check mb-2' }, attr: { class: 'form-check-input' } }) }}
    {{ form_row(form.label, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.translations, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input ~ ' font-monospace', rows: 4, spellcheck: 'false' } }) }}
    {{ form_row(form.icon, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.parent, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_rest(form) }}
    <div class="{{ ui.row_actions() }}" style="justify-content:flex-start;margin-top:1rem;">
        <button type="submit" class="{{ ui.btn('primary') }}">{{ is_edit|default(false) ? ('dashboard.form_update'|trans) : ('dashboard.form_create'|trans) }}</button>
        <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans }}</button>
    </div>
{{ form_end(form) }}
</div>
