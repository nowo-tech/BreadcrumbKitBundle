{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{#
  Item create / edit form loaded into the item form dialog (GET ?_partial=1, js/dashboard.js). A plain
  POST: the controller redirects back on success and renders the full-page form (item/form.html.twig) on errors.
  Variables: form, collection, item, title (translated; copied into the dialog title from data-bk-dialog-title), is_edit.
  Blocks: bk_form_fields, bk_form_actions, bk_form_submit, bk_form_cancel.
  Theme slots (bundle NowoBreadcrumbKitBundle): form, form_actions, btn_primary, btn_secondary.
#}
{% set _b = 'NowoBreadcrumbKitBundle' %}
<div id="modal-bk-item-form-container" data-bk-dialog-title="{{ title|default('') }}">
{{ form_start(form, {attr: {class: nowo_ui_class('form', _b)}}) }}
    {% block bk_form_fields %}
        {{ form_errors(form) }}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
    {% endblock %}
    <div class="{{ nowo_ui_class('form_actions', _b) }}"{{ nowo_ui_attrs('form_actions', _b) }}>
        {% block bk_form_actions %}
            {% block bk_form_submit %}
                <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ is_edit|default(false) ? ('dashboard.form_update'|trans) : ('dashboard.form_create'|trans) }}</button>
            {% endblock %}
            {% block bk_form_cancel %}
                <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close>{{ 'dashboard.cancel'|trans }}</button>
            {% endblock %}
        {% endblock %}
    </div>
{{ form_end(form) }}
</div>
