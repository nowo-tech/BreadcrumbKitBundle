{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{#
  Dashboard modals. Each one renders the modal shell (dashboard.partials.modal_shell, default _modal_shell.html.twig),
  so a host repaints every modal by pointing that option at its own shell: no copy of this file is needed.
  Blocks (whole modal): bk_modal_collection_form, bk_modal_item_form, bk_modal_import, bk_modal_delete.
  Classes (dashboard.classes): modal_loading (in the shell), modal_message, modal_actions, btn_secondary, btn_danger.
#}
{% set _bk_c = nowo_breadcrumb_kit_classes|default({}) %}
{% set _bk_shell = (nowo_breadcrumb_kit_partials|default({})).modal_shell ?? '@NowoBreadcrumbKitBundle/dashboard/_modal_shell.html.twig' %}
{% set _bk_modal_classes = modal_classes|default({}) %}

{% block bk_modal_collection_form %}
    {% include _bk_shell with { modal_id: 'modal-bk-collection-form', modal_title: 'dashboard.collection_modal_title'|trans, modal_size: 'collection_form', modal_size_class: _bk_modal_classes.collection_form|default('modal-lg'), modal_body_id: 'modal-bk-collection-form-body', modal_scrollable: true } %}
{% endblock %}

{% block bk_modal_item_form %}
    {% include _bk_shell with { modal_id: 'modal-bk-item-form', modal_title: 'dashboard.item_modal_title'|trans, modal_size: 'item_form', modal_size_class: _bk_modal_classes.item_form|default('modal-lg'), modal_body_id: 'modal-bk-item-form-body', modal_scrollable: true } %}
{% endblock %}

{% block bk_modal_import %}
    {% include _bk_shell with { modal_id: 'modal-bk-import', modal_title: 'dashboard.import_modal_title'|trans, modal_size: 'import', modal_size_class: _bk_modal_classes.import|default(''), modal_body_id: 'modal-bk-import-body', modal_scrollable: true } %}
{% endblock %}

{% if delete_form is defined %}
    {% block bk_modal_delete %}
        {% embed _bk_shell with { modal_id: 'modal-bk-delete', modal_title: 'dashboard.confirm_delete'|trans, modal_size: 'delete', modal_size_class: _bk_modal_classes.delete|default(''), modal_body_id: null, modal_scrollable: false } %}
            {% trans_default_domain 'NowoBreadcrumbKitBundle' %}
            {% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
            {% block bk_modal_body %}
                <p id="modal-bk-delete-message"{% if _bk_c.modal_message is defined %} class="{{ _bk_c.modal_message }}"{% endif %}>{{ 'dashboard.delete_confirm_message'|trans }}</p>
            {% endblock %}
            {% block bk_modal_footer %}
                {{ form_start(delete_form, { attr: { id: 'form-bk-delete-confirm' } }) }}
                    {{ form_widget(delete_form) }}
                    <div class="{{ _bk_c.modal_actions ?? ui.row_actions() }}"{% if _bk_c.modal_actions is not defined %} style="justify-content:flex-end;"{% endif %}>
                        <button type="button" class="{{ _bk_c.btn_secondary ?? ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans }}</button>
                        <button type="submit" class="{{ _bk_c.btn_danger ?? ui.btn('danger') }}">{{ 'dashboard.delete'|trans }}</button>
                    </div>
                {{ form_end(delete_form, { render_rest: false }) }}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endif %}
