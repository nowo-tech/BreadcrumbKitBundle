{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{#
  JSON import form: rendered inside the import dialog of the collections index (and by GET import?_partial=1 for
  1.x integrations). A plain multipart POST; the import page (import.html.twig) is its full-page / no-JS fallback.
  Variables: form, dialog (true: the cancel button closes the UiKit dialog).
  Blocks: bk_import_intro (format hint), bk_form_fields, bk_form_actions, bk_form_submit, bk_form_cancel.
  Theme slots (bundle NowoBreadcrumbKitBundle): muted, form, form_actions, btn_primary, btn_secondary.
#}
{% set _b = 'NowoBreadcrumbKitBundle' %}
<div id="modal-bk-import-container" data-bk-dialog-title="{{ 'dashboard.import_modal_title'|trans }}">
    {{ form_start(form, {attr: {class: nowo_ui_class('form', _b), 'data-bk-submit-once': '1'}}) }}
        {% block bk_import_intro %}
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'dashboard.import_partial_hint'|trans|raw }}</p>
        {% endblock %}
        {% block bk_form_fields %}
            {{ form_errors(form) }}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {% endblock %}
        <div class="{{ nowo_ui_class('form_actions', _b) }}"{{ nowo_ui_attrs('form_actions', _b) }}>
            {% block bk_form_actions %}
                {% block bk_form_submit %}
                    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ 'dashboard.import_submit'|trans }}</button>
                {% endblock %}
                {% block bk_form_cancel %}
                    <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close>{{ 'dashboard.cancel'|trans }}</button>
                {% endblock %}
            {% endblock %}
        </div>
    {{ form_end(form) }}
</div>
