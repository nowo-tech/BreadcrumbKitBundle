{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _input = ui.input() %}
<div id="modal-bk-collection-form-container">
{{ form_start(form, { attr: { class: 'bk-dashboard-form' } }) }}
    <input type="hidden" name="_modal" value="1">
    {{ form_row(form.code, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.contextKey, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.name, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.homeIcon, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.separatorIcon, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.classList, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.classItem, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.classSeparator, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.classCurrent, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {{ form_row(form.responsiveConfigJson, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input ~ ' font-monospace', rows: 6, spellcheck: 'false' } }) }}
    {% if form.inlineEditAccessKey is defined %}
        {{ form_row(form.inlineEditAccessKey, { label_attr: { class: 'form-label' }, row_attr: { class: 'mb-2' }, attr: { class: _input } }) }}
    {% endif %}
    {{ form_rest(form) }}
    <div class="{{ ui.row_actions() }}" style="justify-content:flex-start;margin-top:1rem;">
        <button type="submit" class="{{ ui.btn('primary') }}">{{ is_edit|default(false) ? ('dashboard.form_update'|trans) : ('dashboard.form_create'|trans) }}</button>
        <button type="button" class="{{ ui.btn('secondary') }}" {{ ui.modal_dismiss_attrs()|raw }}>{{ 'dashboard.cancel'|trans }}</button>
    </div>
{{ form_end(form) }}
</div>
