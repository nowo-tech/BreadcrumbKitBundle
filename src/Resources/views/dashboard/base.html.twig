{% extends nowo_breadcrumb_kit_layout_template|default('@NowoBreadcrumbKitBundle/dashboard/layout.html.twig') %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}

{% set dashboard_routes = dashboard_routes|default({
    collections_index: 'nowo_breadcrumb_kit_dashboard_collections_index',
    collections_edit: 'nowo_breadcrumb_kit_dashboard_collections_edit',
    import: 'nowo_breadcrumb_kit_dashboard_import',
    export_all: 'nowo_breadcrumb_kit_dashboard_export_all',
}) %}

{# When the host sets layout_template to the project layout, stack assets via parent().
   Do NOT redefine nested nowo_ui_styles / nowo_ui_scripts here — that would replace the
   layout CDN (Bootstrap/etc.) when parent() is rendered (Twig nested-block inheritance). #}
{# dashboard.ui_kit_stylesheet: false when the host layout already loads nowo-ui.css before its own CSS
   (re-appending it last would reassert the UiKit :root tokens over the host theme). #}
{% block stylesheets %}
    {{ parent() }}
    {% if nowo_breadcrumb_kit_ui_kit_stylesheet ?? true %}
    <link href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}" rel="stylesheet">
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% set _bk_nonce = app.request is defined and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
    <script src="{{ asset('js/dashboard.js', 'nowo_breadcrumb_kit') }}" defer{% if _bk_nonce %} nonce="{{ _bk_nonce }}"{% endif %}></script>
{% endblock %}

{% block nowo_breadcrumb_kit_content %}
    {% set modal_classes = modal_classes|default({}) %}
    {% block nowo_ui_flashes %}
        {% for msg in app.flashes('success') %}
            <div class="{{ ui.flash('success') }}">{{ msg }}</div>
        {% endfor %}
        {% for msg in app.flashes('danger') %}
            <div class="{{ ui.flash('danger') }}">{{ msg }}</div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div class="{{ ui.flash('error') }}">{{ msg }}</div>
        {% endfor %}
    {% endblock %}

    {# Do not redefine nowo_ui_content here — layout nests nowo_breadcrumb_kit_content
       inside nowo_ui_content; a child redefinition would replace that and drop modals. #}
    {% block body %}{% endblock %}

    {% block nowo_ui_modals %}
        {% include (nowo_breadcrumb_kit_partials|default({})).modals ?? '@NowoBreadcrumbKitBundle/dashboard/_dashboard_modals.html.twig' %}
    {% endblock %}
{% endblock %}
