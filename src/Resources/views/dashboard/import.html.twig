{#
  JSON import page (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from DashboardPages::import()).
  The collections index opens the same form in a dialog (_import_partial.html.twig); this page is its full-page /
  no-JS fallback and the page shown again with the flashes when an upload is rejected.
  Data block filled: nowo_ui_form_body (format hint, form-level errors, then the default child loop).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}

{% block nowo_ui_form_body %}
    <p class="{{ nowo_ui_class('muted', page.bundle) }}">{{ 'dashboard.import_partial_hint'|trans|raw }}</p>
    {{ form_errors(form) }}
    {{ parent() }}
{% endblock %}
