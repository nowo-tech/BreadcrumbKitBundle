{#
  Empty UiKit `dialog` (REQ-UI-003) that holds a dashboard form: UiKit 2.2 remote dialog — an Action with
  dialogId="<id>" and the form URL opens it and js/nowo-ui-dialog.js fetches the form partial into the body marked
  data-nowo-ui-dialog-body (body_attr); js/dashboard.js shows the loading text and sets the title from the form.
  Without JavaScript the opener is a plain link to the full-page form.
  Variables: id, title (string), size (sm | md | lg | xl), bundle.
#}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% set _body %}<p class="{{ nowo_ui_class('muted', bundle) }}">{{ 'dashboard.loading'|trans }}</p>{% endset %}
{{ include(nowo_ui_partial('dialog', bundle), {
    id: id,
    title: title,
    body: _body,
    body_attr: {'data-nowo-ui-dialog-body': true, 'data-bk-dialog-body': true, 'data-bk-loading': 'dashboard.loading'|trans, 'data-bk-error': 'dashboard.error_loading_form'|trans},
    size: size,
    close_label: 'dashboard.close'|trans,
    attr: {'data-testid': id},
    bundle: bundle,
}) }}
