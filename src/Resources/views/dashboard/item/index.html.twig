{#
  Items of one collection (REQ-UI-003): UiKit list scaffold. Variables: page (View\ListPage from
  DashboardPages::itemsIndex(): rows are BreadcrumbItem entities), collection (BreadcrumbCollection),
  nowo_breadcrumb_kit_dialog_sizes.
  Data blocks filled: nowo_ui_list_row (cells), nowo_ui_modals (item form + collection styles dialogs, UiKit `dialog`
  partial), nowo_ui_scripts (js/dashboard.js).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    {% set _muted = _cell ~ ' ' ~ nowo_ui_class('table_cell_muted', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'dashboard.table_route'|trans }}"><code>{{ row.routeName }}</code></td>
    <td class="{{ row.label ? _cell : _muted }}" data-label="{{ 'dashboard.table_label'|trans }}">{{ row.label ?: '—' }}</td>
    <td class="{{ row.parent ? _cell : _muted }}" data-label="{{ 'dashboard.table_parent'|trans }}" data-nowo-ui-priority="3">
        {%- if row.parent -%}
            <code>{{ row.parent.routeName }}</code> <span class="{{ nowo_ui_class('muted', page.bundle) }}">#{{ row.parent.id }}</span>
        {%- else -%}
            —
        {%- endif -%}
    </td>
    <td class="{{ _cell }}" data-label="{{ 'dashboard.table_link'|trans }}" data-nowo-ui-priority="2">
        <span class="{{ nowo_ui_class(row.linkEnabled ? 'badge_success' : 'badge_neutral', page.bundle) }}">{{ (row.linkEnabled ? 'dashboard.link_yes' : 'dashboard.link_no')|trans }}</span>
    </td>
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {% set _sizes = nowo_breadcrumb_kit_dialog_sizes|default({}) %}
    {{ include('@NowoBreadcrumbKitBundle/dashboard/_form_dialog.html.twig', {
        id: constant('Nowo\\BreadcrumbKitBundle\\Dashboard\\DashboardPages::DIALOG_ITEM_FORM'),
        title: 'dashboard.item_modal_title'|trans,
        size: _sizes.item_form|default('lg'),
        bundle: page.bundle,
    }) }}
    {{ include('@NowoBreadcrumbKitBundle/dashboard/_form_dialog.html.twig', {
        id: constant('Nowo\\BreadcrumbKitBundle\\Dashboard\\DashboardPages::DIALOG_COLLECTION_FORM'),
        title: 'dashboard.collection_modal_title'|trans,
        size: _sizes.collection_form|default('lg'),
        bundle: page.bundle,
    }) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoBreadcrumbKitBundle/dashboard/_dashboard_scripts.html.twig') }}
{% endblock %}
