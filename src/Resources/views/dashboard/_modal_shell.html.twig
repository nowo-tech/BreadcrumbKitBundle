{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{#
  Default modal shell (Bootstrap markup + semantic nowo-ui-modal, REQ-UI-001). Embedded once per dashboard modal
  by _dashboard_modals.html.twig; replace it with dashboard.partials.modal_shell to repaint every modal.

  Variables:
    modal_id          element id (keep it: dashboard.js targets #modal-bk-*)
    modal_title       translated title (the title element id must stay "{modal_id}-label")
    modal_size        logical key: collection_form | item_form | import | delete
    modal_size_class  framework class resolved from dashboard.modals (modal-lg, modal-xl or '')
    modal_body_id     id of the element whose content dashboard.js replaces with the AJAX form (null for delete)
    modal_scrollable  bool
  Blocks: bk_modal_body (content; defaults to the loading placeholder the AJAX form replaces),
          bk_modal_footer (actions; inside the body by default)
  Classes (dashboard.classes): modal_loading
#}
{% set _bk_c = nowo_breadcrumb_kit_classes|default({}) %}
<div class="modal fade nowo-ui-modal" id="{{ modal_id }}" tabindex="-1" aria-labelledby="{{ modal_id }}-label" aria-hidden="true">
    <div class="modal-dialog{% if modal_scrollable|default(false) %} modal-dialog-scrollable{% endif %} {{ modal_size_class|default('') }}">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="{{ modal_id }}-label">{{ modal_title }}</h5>
                <button type="button" class="btn-close" {{ ui.modal_dismiss_attrs()|raw }} aria-label="{{ 'dashboard.close'|trans }}"></button>
            </div>
            <div class="modal-body"{% if modal_body_id|default(null) %} id="{{ modal_body_id }}"{% endif %}>
                {% block bk_modal_body %}
                    <div class="{{ _bk_c.modal_loading ?? ('text-center py-4 ' ~ ui.muted()) }}">{{ 'dashboard.loading'|trans }}</div>
                {% endblock %}
                {% block bk_modal_footer %}{% endblock %}
            </div>
        </div>
    </div>
</div>
