{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% set _bk_fw = nowo_breadcrumb_kit_css_framework|default('bootstrap5') %}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block nowo_ui_document_title %}{% block dashboard_title %}{{ 'dashboard.title'|trans }}{% endblock %} — {{ 'dashboard.title_suffix'|trans }}{% endblock %}</title>
    {% block stylesheets %}
        {% block nowo_ui_styles %}
            {# Demo layout CDNs — skipped when host sets layout_template to the project layout. #}
            {% if _bk_fw in ['bootstrap', 'bootstrap5', 'tabler'] %}
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            {% elseif _bk_fw == 'bootstrap4' %}
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
            {% elseif _bk_fw == 'tailwind' %}
                <script src="https://cdn.tailwindcss.com"></script>
            {% elseif _bk_fw == 'foundation' %}
                <link href="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/css/foundation.min.css" rel="stylesheet">
            {% endif %}
            <link href="{{ asset('bundles/nowobreadcrumbkit/css/nowo-ui.css') }}" rel="stylesheet">
        {% endblock %}
        {% block dashboard_head %}
        <style>
            {# Tom Select dropdown appended to body must stack above Bootstrap 5 modals (z-index 1055). #}
            body > .ts-dropdown { z-index: 1060; }
        </style>
        {% endblock %}
    {% endblock %}
</head>
<body class="nowo-ui-body{% if _bk_fw in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %} bg-light{% elseif _bk_fw == 'tailwind' %} bg-slate-50{% endif %}">
    {% set _bk_dr = dashboard_routes|default({}) %}
    {% if _bk_fw in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path(_bk_dr.collections_index|default('nowo_breadcrumb_kit_dashboard_collections_index')) }}">{{ 'dashboard.title'|trans }}</a>
        </div>
    </nav>
    {% else %}
    <header class="nowo-ui-page-header" style="padding:0.75rem 1rem;border-bottom:1px solid #e2e8f0;background:#0f172a;">
        <a class="nowo-ui-btn nowo-ui-btn--link" style="color:#fff;" href="{{ path(_bk_dr.collections_index|default('nowo_breadcrumb_kit_dashboard_collections_index')) }}">{{ 'dashboard.title'|trans }}</a>
    </header>
    {% endif %}
    <main class="{% if _bk_fw in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %}container-fluid py-4{% elseif _bk_fw == 'tailwind' %}mx-auto max-w-7xl px-4 py-6{% else %}nowo-ui-content{% endif %}" style="{% if _bk_fw in ['custom', 'none', 'foundation'] %}padding:1rem;{% endif %}">
        {% block nowo_ui_content %}{% block nowo_breadcrumb_kit_content %}{% endblock %}{% endblock %}
    </main>
    {% block javascripts %}
        {% block nowo_ui_scripts %}
            {% if _bk_fw in ['bootstrap', 'bootstrap5', 'tabler'] %}
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            {% elseif _bk_fw == 'bootstrap4' %}
                <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
            {% elseif _bk_fw == 'foundation' %}
                <script src="https://cdn.jsdelivr.net/npm/foundation-sites@6.8.1/dist/js/foundation.min.js"></script>
            {% endif %}
        {% endblock %}
        {% block dashboard_scripts %}{% endblock %}
        <script src="{{ asset('bundles/nowobreadcrumbkit/js/dashboard.js') }}" defer></script>
        <script>
        window.breadcrumbKitI18n = {
            loading: {{ 'dashboard.loading'|trans|json_encode|raw }},
            errorLoadingForm: {{ 'dashboard.error_loading_form'|trans|json_encode|raw }},
            defaultCollectionModalTitle: {{ 'dashboard.collection_modal_title'|trans|json_encode|raw }},
            defaultItemModalTitle: {{ 'dashboard.item_modal_title'|trans|json_encode|raw }},
            deleteCollectionConfirm: {{ 'dashboard.delete_collection_confirm'|trans|json_encode|raw }},
            deleteItemConfirm: {{ 'dashboard.delete_item_confirm'|trans|json_encode|raw }}
        };
        window.__breadcrumbKitDashboard = window.__breadcrumbKitDashboard || {};
        window.__breadcrumbKitDashboard.cssFramework = {{ _bk_fw|json_encode|raw }};
        window.__breadcrumbKitDashboard.importPartialUrl = {{ (path(_bk_dr.import|default('nowo_breadcrumb_kit_dashboard_import')) ~ '?_partial=1')|json_encode|raw }};
        window.__breadcrumbKitDashboard.dashboardBase = {{ path(_bk_dr.collections_index|default('nowo_breadcrumb_kit_dashboard_collections_index'))|json_encode|raw }};
        </script>
    {% endblock %}
</body>
</html>
