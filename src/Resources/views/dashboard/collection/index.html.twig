{#
  Collections index (REQ-UI-003): UiKit list scaffold. Variables: page (View\ListPage from
  DashboardPages::collectionsIndex(): rows {id, code, name, contextKey, items}), import_form (FormView of the import
  dialog), nowo_breadcrumb_kit_dialog_sizes.
  Data blocks filled: nowo_ui_list_row (cells), nowo_ui_modals (collection form + import dialogs, UiKit `dialog`
  partial), nowo_ui_scripts (js/dashboard.js).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    {% set _muted = _cell ~ ' ' ~ nowo_ui_class('table_cell_muted', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'dashboard.table_code'|trans }}"><a href="{{ path('nowo_breadcrumb_kit_dashboard_items_index', {collectionId: row.id}) }}"><code>{{ row.code }}</code></a></td>
    <td class="{{ row.name ? _cell : _muted }}" data-label="{{ 'dashboard.table_name'|trans }}">{{ row.name ?: '—' }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'dashboard.table_items'|trans }}" data-nowo-ui-priority="2"><span class="{{ nowo_ui_class('badge_neutral', page.bundle) }}">{{ row.items }}</span></td>
    <td class="{{ row.contextKey ? _cell : _muted }}" data-label="{{ 'dashboard.table_context'|trans }}" data-nowo-ui-priority="3">{{ row.contextKey ?: '—' }}</td>
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {% set _sizes = nowo_breadcrumb_kit_dialog_sizes|default({}) %}
    {{ include('@NowoBreadcrumbKitBundle/dashboard/_form_dialog.html.twig', {
        id: constant('Nowo\\BreadcrumbKitBundle\\Dashboard\\DashboardPages::DIALOG_COLLECTION_FORM'),
        title: 'dashboard.collection_modal_title'|trans,
        size: _sizes.collection_form|default('lg'),
        bundle: page.bundle,
    }) }}
    {% if import_form is defined and import_form %}
        {{ include(nowo_ui_partial('dialog', page.bundle), {
            id: constant('Nowo\\BreadcrumbKitBundle\\Dashboard\\DashboardPages::DIALOG_IMPORT'),
            title: 'dashboard.import_modal_title'|trans,
            body: include('@NowoBreadcrumbKitBundle/dashboard/_import_partial.html.twig', {form: import_form, dialog: true}),
            size: _sizes.import|default('md'),
            close_label: 'dashboard.close'|trans,
            attr: {'data-testid': 'bk-import-dialog'},
            bundle: page.bundle,
        }) }}
    {% endif %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ include('@NowoBreadcrumbKitBundle/dashboard/_dashboard_scripts.html.twig') }}
{% endblock %}
