{% extends '@NowoBreadcrumbKitBundle/dashboard/base.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoBreadcrumbKitBundle/dashboard/_icons.html.twig' as bk_icon %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{#
  Admin chrome hooks (docs/USAGE.md § Customising the admin chrome):
  - class map nowo_breadcrumb_kit_classes (dashboard.classes), partial map nowo_breadcrumb_kit_partials (dashboard.partials)
  - slot blocks (definition only; host layouts pull them with block()): bk_page_title, bk_page_intro, bk_page_actions
  - page blocks: bk_page_header, bk_search, bk_toolbar, bk_results, bk_empty_state, bk_collections_list,
    bk_collection_row, bk_collection_table_row, bk_collection_row_actions, bk_pagination
  - layout contract: bk_page_actions_in_layout (bool), bk_title_suffix (string)
#}
{% set _bk_c = nowo_breadcrumb_kit_classes|default({}) %}
{% set _bk_p = nowo_breadcrumb_kit_partials|default({}) %}
{% set _bk_view = nowo_breadcrumb_kit_collections_view|default('list') %}
{% set _bk_actions_end = nowo_breadcrumb_kit_row_actions_position|default('start') == 'end' %}
{% set _bk_display = nowo_ui_kit_row_actions_display|default('icon') %}

{% block title %}{{ block('bk_page_title') }}{{ bk_title_suffix|default('') }}{% endblock %}

{% block bk_page_title %}{{ 'dashboard.collections_heading'|trans }}{% endblock %}
{% block bk_page_intro %}{{ 'dashboard.collections_lead'|trans }}{% endblock %}

{% block bk_page_actions %}
    <a href="{{ path(dashboard_routes.export_all|default('nowo_breadcrumb_kit_dashboard_export_all')) }}" class="{{ _bk_c.btn_secondary ?? ui.btn('secondary') }}" target="_blank" rel="noopener noreferrer">{{ 'dashboard.export_all'|trans }}</a>
    <button type="button" class="{{ _bk_c.btn_secondary ?? ui.btn('secondary') }} btn-bk-import" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-import')|raw }} data-bk-import-url="{{ path(dashboard_routes.import|default('nowo_breadcrumb_kit_dashboard_import')) }}?_partial=1">{{ 'dashboard.import'|trans }}</button>
    <button type="button" class="{{ _bk_c.btn_primary ?? ui.btn('primary') }} btn-bk-collection-form" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-collection-form')|raw }} data-bk-url="{{ path(dashboard_routes.new|default('nowo_breadcrumb_kit_dashboard_collections_new')) }}?_partial=1" data-bk-title="{{ 'dashboard.new_collection_modal_title'|trans|e('html_attr') }}">{{ 'dashboard.new_collection'|trans }}</button>
{% endblock %}

{% block body %}
    {% block bk_page_header %}{% endblock %}

    {% block bk_search %}
        {{ form_start(search_form, { attr: { class: _bk_c.search_form ?? ui.search_form(), role: 'search' } }) }}
            {{ form_widget(search_form.q, { attr: { class: _bk_c.search_input ?? ui.search_input(), placeholder: 'dashboard.search_placeholder'|trans, 'aria-label': 'dashboard.search'|trans, autocomplete: 'off' } }) }}
            <button type="submit" class="{{ _bk_c.btn_secondary ?? ui.btn('secondary') }}">{{ 'dashboard.filter'|trans }}</button>
            <a href="{{ path(dashboard_routes.index|default('nowo_breadcrumb_kit_dashboard_collections_index')) }}" class="{{ _bk_c.btn_secondary ?? ui.btn('secondary') }}">{{ 'dashboard.clear_filters'|trans }}</a>
        {{ form_end(search_form, { render_rest: false }) }}
    {% endblock %}

    {% block bk_toolbar %}
        {% if not bk_page_actions_in_layout|default(false) %}
            <div class="{{ _bk_c.toolbar ?? ui.toolbar() }}">
                {{ block('bk_page_actions') }}
            </div>
        {% endif %}
    {% endblock %}

    {% block bk_results %}
        {% if _bk_c.results is defined %}<section class="{{ _bk_c.results }}" data-testid="breadcrumb-kit-collections-table">{% endif %}
        {% if collections is empty %}
            {% block bk_empty_state %}
                <p class="{{ _bk_c.empty ?? ui.empty() }}">{{ 'dashboard.empty_collections'|trans }}</p>
            {% endblock %}
        {% else %}
            {% block bk_collections_list %}
                {% if _bk_view == 'table' %}
                    <div class="{{ _bk_c.table_wrap ?? ui.table_wrap() }}">
                        <table class="{{ _bk_c.table ?? ui.table() }}">
                            <thead>
                                <tr{% if _bk_c.thead_row is defined %} class="{{ _bk_c.thead_row }}"{% endif %}>
                                    {% if not _bk_actions_end %}<th class="{{ _bk_c.th_actions ?? 'text-nowrap' }}">{{ 'dashboard.table_actions'|trans }}</th>{% endif %}
                                    <th{% if _bk_c.th is defined %} class="{{ _bk_c.th }}"{% endif %}>{{ 'dashboard.table_code'|trans }}</th>
                                    <th{% if _bk_c.th is defined %} class="{{ _bk_c.th }}"{% endif %}>{{ 'dashboard.table_name'|trans }}</th>
                                    <th{% if _bk_c.th is defined %} class="{{ _bk_c.th }}"{% endif %}>{{ 'dashboard.table_items'|trans }}</th>
                                    <th{% if _bk_c.th is defined %} class="{{ _bk_c.th }}"{% endif %}>{{ 'dashboard.table_context'|trans }}</th>
                                    {% if _bk_actions_end %}<th class="{{ _bk_c.th_actions ?? 'text-nowrap' }}">{{ 'dashboard.table_actions'|trans }}</th>{% endif %}
                                </tr>
                            </thead>
                            <tbody>
                            {% for c in collections %}
                                {% set _itemsCount = collection_item_counts[c.id]|default(0) %}
                                {% block bk_collection_table_row %}
                                    <tr{% if _bk_c.row is defined %} class="{{ _bk_c.row }}"{% endif %}>
                                        {% if not _bk_actions_end %}<td class="{{ _bk_c.td_actions ?? 'text-nowrap' }}"><div class="{{ _bk_c.row_actions ?? ui.row_actions() }}" aria-label="{{ 'dashboard.table_actions'|trans }}">{{ block('bk_collection_row_actions') }}</div></td>{% endif %}
                                        <td{% if _bk_c.td is defined %} class="{{ _bk_c.td }}"{% endif %}><a href="{{ path('nowo_breadcrumb_kit_dashboard_items_index', { collectionId: c.id }) }}"><code>{{ c.code }}</code></a></td>
                                        <td{% if _bk_c.td is defined %} class="{{ _bk_c.td }}"{% endif %}>{{ c.name|default('—') }}</td>
                                        <td{% if _bk_c.td is defined %} class="{{ _bk_c.td }}"{% endif %}><span class="{{ _bk_c.badge ?? ui.badge() }}">{{ _itemsCount }}</span></td>
                                        <td{% if _bk_c.td is defined %} class="{{ _bk_c.td }}"{% endif %}>{{ c.contextKey is not empty ? c.contextKey : '—' }}</td>
                                        {% if _bk_actions_end %}<td class="{{ _bk_c.td_actions ?? 'text-nowrap' }}"><div class="{{ _bk_c.row_actions ?? ui.row_actions() }}" aria-label="{{ 'dashboard.table_actions'|trans }}">{{ block('bk_collection_row_actions') }}</div></td>{% endif %}
                                    </tr>
                                {% endblock %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <ul class="{{ _bk_c.list ?? ui.list() }}">
                        {% for c in collections %}
                            {% set _itemsCount = collection_item_counts[c.id]|default(0) %}
                            {% block bk_collection_row %}
                                <li class="{{ _bk_c.list_item ?? ui.list_item() }}">
                                    <div>
                                        <strong>{{ c.code }}</strong>
                                        <span class="{{ _bk_c.badge ?? ui.badge() }}" title="{{ _itemsCount }}">{{ _itemsCount }}</span>
                                        {% if c.name %}<span class="{{ _bk_c.muted ?? ui.muted() }}"> — {{ c.name }}</span>{% endif %}
                                        {% if c.contextKey is not empty %}
                                            <br><span class="small {{ _bk_c.muted ?? ui.muted() }}">{{ 'dashboard.context'|trans }}: {{ c.contextKey }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="{{ _bk_c.row_actions ?? ui.row_actions() }}">
                                        {{ block('bk_collection_row_actions') }}
                                    </div>
                                </li>
                            {% endblock %}
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endblock %}
            {% block bk_pagination %}
                {% if pagination is not null %}
                    {% include _bk_p.pagination ?? '@NowoBreadcrumbKitBundle/dashboard/_pagination.html.twig' with {
                        pagination: pagination,
                        item_count: collections|length,
                        route: dashboard_routes.index|default('nowo_breadcrumb_kit_dashboard_collections_index'),
                        route_params: {},
                        query: search is not empty ? { q: search } : {},
                        nav_label: 'dashboard.pagination_collections',
                        nav_trans_domain: 'NowoBreadcrumbKitBundle',
                    } %}
                {% endif %}
            {% endblock %}
        {% endif %}
        {% if _bk_c.results is defined %}</section>{% endif %}
    {% endblock %}
{% endblock %}

{# Row actions for collection `c` (shared by the list and table views). #}
{% block bk_collection_row_actions %}
    {% set _l_items = 'dashboard.link_items'|trans %}
    {% set _l_export = 'dashboard.link_export_json'|trans %}
    {% set _l_edit = 'dashboard.link_edit'|trans %}
    {% set _l_delete = 'dashboard.delete'|trans %}
    <a href="{{ path('nowo_breadcrumb_kit_dashboard_items_index', { collectionId: c.id }) }}" class="{{ _bk_c.action_view ?? ui.action('view') }}" title="{{ _l_items }}" aria-label="{{ _l_items }}">{% if _bk_p.action_inner is defined %}{% include _bk_p.action_inner with { display: _bk_display, icon_name: 'view', label: _l_items } only %}{% else %}{{ bk_icon.items() }}{% endif %}</a>
    <a href="{{ path(dashboard_routes.export|default('nowo_breadcrumb_kit_dashboard_collections_export'), { id: c.id }) }}" class="{{ _bk_c.action_view ?? ui.action('view') }}" target="_blank" rel="noopener noreferrer" title="{{ _l_export }}" aria-label="{{ _l_export }}">{% if _bk_p.action_inner is defined %}{% include _bk_p.action_inner with { display: _bk_display, icon_name: 'export', label: _l_export } only %}{% else %}{{ bk_icon.export_json() }}{% endif %}</a>
    <button type="button" class="{{ _bk_c.action_edit ?? ui.action('edit') }} btn-bk-collection-form" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-collection-form')|raw }} data-bk-url="{{ path(dashboard_routes.edit|default('nowo_breadcrumb_kit_dashboard_collections_edit'), { id: c.id }) }}?_partial=1" data-bk-title="{{ 'dashboard.edit_collection_modal_title'|trans({'%code%': c.code})|e('html_attr') }}" title="{{ _l_edit }}" aria-label="{{ _l_edit }}">{% if _bk_p.action_inner is defined %}{% include _bk_p.action_inner with { display: _bk_display, icon_name: 'edit', label: _l_edit } only %}{% else %}{{ bk_icon.edit() }}{% endif %}</button>
    <button type="button" class="{{ _bk_c.action_delete ?? ui.action('delete') }} btn-bk-delete" data-id="{{ c.id }}" data-name="{{ c.code }}{% if c.name %} — {{ c.name }}{% endif %}" data-url="{{ path(dashboard_routes.delete|default('nowo_breadcrumb_kit_dashboard_collections_delete'), { id: c.id }) }}" data-token="{{ csrf_token('delete_collection_' ~ c.id) }}" {{ ui.modal_toggle_attrs()|raw }} {{ ui.modal_target_attr('modal-bk-delete')|raw }} title="{{ _l_delete }}" aria-label="{{ _l_delete }}">{% if _bk_p.action_inner is defined %}{% include _bk_p.action_inner with { display: _bk_display, icon_name: 'delete', label: _l_delete } only %}{% else %}{{ bk_icon.trash() }}{% endif %}</button>
{% endblock %}

{% block dashboard_scripts %}
<script type="application/json" id="nowo-breadcrumb-kit-dashboard-page">{"page":"collections_index"}</script>
{% endblock %}
