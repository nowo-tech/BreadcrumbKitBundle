{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{#
  Default dashboard pagination (replace with dashboard.partials.pagination, e.g. a UiKit _pagination bridge).
  Variables: pagination {current_page, per_page, total, total_pages}, item_count, route, route_params,
  query, nav_label, nav_trans_domain.
#}
{% if pagination.total_pages > 1 %}
    {% set _params = route_params|default({})|merge(query|default({})) %}
    <nav aria-label="{{ nav_label|trans({}, nav_trans_domain|default('NowoBreadcrumbKitBundle')) }}" class="mt-3 nowo-ui-pagination">
        <ul class="pagination pagination-sm flex-wrap">
            <li class="page-item{% if pagination.current_page <= 1 %} disabled{% endif %}">
                <a class="page-link" href="{% if pagination.current_page > 1 %}{{ path(route, _params|merge({ page: pagination.current_page - 1 })) }}{% else %}#{% endif %}" aria-label="{{ 'dashboard.previous'|trans }}">«</a>
            </li>
            {% for p in 1..pagination.total_pages %}
                <li class="page-item{% if p == pagination.current_page %} active{% endif %}">
                    <a class="page-link" href="{{ path(route, _params|merge({ page: p })) }}">{{ p }}</a>
                </li>
            {% endfor %}
            <li class="page-item{% if pagination.current_page >= pagination.total_pages %} disabled{% endif %}">
                <a class="page-link" href="{% if pagination.current_page < pagination.total_pages %}{{ path(route, _params|merge({ page: pagination.current_page + 1 })) }}{% else %}#{% endif %}" aria-label="{{ 'dashboard.next'|trans }}">»</a>
            </li>
        </ul>
        <p class="small {{ ui.muted() }} mt-1">
            {% set from = item_count > 0 ? (pagination.current_page - 1) * pagination.per_page + 1 : 0 %}
            {% set to = (pagination.current_page - 1) * pagination.per_page + item_count %}
            {{ 'dashboard.showing_from_to_of_total'|trans({ '%from%': from, '%to%': to, '%total%': pagination.total }) }}
        </p>
    </nav>
{% endif %}
