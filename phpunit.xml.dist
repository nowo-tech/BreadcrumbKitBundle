<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- 2.20 (Beacon spec 239): real-server lock wait and multi-process tests; skipped without
             BREADCRUMB_TEST_DATABASE_URL (the CI "Load readiness" job runs them with fail-on-skipped). -->
        <testsuite name="database">
            <directory>tests/Database</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory suffix=".php">src/Command</directory>
            <directory suffix=".php">src/Controller/Dashboard</directory>
            <directory suffix=".php">src/Form/Dashboard</directory>
            <directory suffix=".php">src/Repository</directory>
            <file>src/Form/BreadcrumbCollectionType.php</file>
            <file>src/Form/BreadcrumbItemType.php</file>
            <file>src/Twig/BreadcrumbKitDashboardLinkExtension.php</file>
            <file>src/Twig/BreadcrumbKitDashboardGlobalsExtension.php</file>
            <file>src/polyfill-template-aware-data-collector.php</file>
            <!-- doctrine/dbal 3 form of the driver connection: loaded and tested by the DBAL 3 legs of the CI "Load readiness" job. -->
            <file>src/Doctrine/AfterCommitConnectionDbal3.php</file>
        </exclude>
    </source>

    <coverage>
        <report>
            <html outputDirectory="coverage"/>
            <clover outputFile="coverage.xml"/>
        </report>
    </coverage>

    <php>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="max[direct]=0"/>
    </php>
</phpunit>
