{# Demo navigation: UiKit aside markup (nowo-ui-aside__label / nowo-ui-aside__link), included by base.html.twig. #}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% set route = app.request.attributes.get('_route') %}
{% set section = app.request.attributes.get('section') %}
{% set admin_long_routes = ['app_admin_long_w1', 'app_admin_long_w2', 'app_admin_long_w3', 'app_admin_long_w4', 'app_admin_long_w5'] %}
{% set dashboard_collections_url = breadcrumb_kit_dashboard_collections_url() %}
{% set dashboard_routes_prefix = 'nowo_breadcrumb_kit_dashboard_' %}
{% set is_dashboard = route is not null and route starts with dashboard_routes_prefix %}

<div class="nowo-ui-aside__inner">
    <p class="nowo-ui-aside__label">{{ 'demo.sidebar.navigation'|trans }}</p>
    <nav class="nowo-ui-aside__nav" aria-label="{{ 'demo.sidebar.aria'|trans }}">
        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_start'|trans }}</p>
        <a href="{{ path('app_home') }}" class="nowo-ui-aside__link{{ route == 'app_home' ? ' is-current' : '' }}">{{ 'demo.sidebar.overview'|trans }}</a>

        {% if dashboard_collections_url %}
        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_manage'|trans }}</p>
        <a href="{{ dashboard_collections_url }}" class="nowo-ui-aside__link{{ is_dashboard ? ' is-current' : '' }}">{{ 'demo.sidebar.breadcrumb_editor'|trans }}</a>
        <p class="nowo-ui-muted"><code class="nowo-ui-code">{{ breadcrumb_kit_dashboard_path_prefix }}</code></p>
        {% endif %}

        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_inline'|trans }}</p>
        <a class="nowo-ui-aside__link" href="{{ path('app_home', { _locale: app.request.locale }) }}?breadcrumb_edit=1">{{ 'demo.sidebar.home_with_flag'|trans }}</a>
        <a class="nowo-ui-aside__link" href="{{ path('app_product_show', { _locale: app.request.locale, id: 42 }) }}?breadcrumb_edit=1">{{ 'demo.sidebar.product_with_modal'|trans }}</a>

        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_chain'|trans }}</p>
        <a href="{{ path('app_shop') }}" class="nowo-ui-aside__link{{ route == 'app_shop' ? ' is-current' : '' }}">{{ 'demo.sidebar.shop'|trans }}</a>
        <a href="{{ path('app_product_show', { id: 42 }) }}" class="nowo-ui-aside__link{{ route == 'app_product_show' ? ' is-current' : '' }}">{{ 'demo.sidebar.product_42'|trans }}</a>

        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_static'|trans }}</p>
        <a href="{{ path('app_section_show', { section: 'sales' }) }}" class="nowo-ui-aside__link{{ route == 'app_section_show' and section == 'sales' ? ' is-current' : '' }}">{{ 'demo.sidebar.sales'|trans }}</a>
        <a href="{{ path('app_section_show', { section: 'support' }) }}" class="nowo-ui-aside__link{{ route == 'app_section_show' and section == 'support' ? ' is-current' : '' }}">{{ 'demo.sidebar.support'|trans }}</a>

        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_depth'|trans }}</p>
        <a href="{{ path('app_demo_deep') }}" class="nowo-ui-aside__link{{ route == 'app_demo_deep' ? ' is-current' : '' }}">{{ 'demo.sidebar.long_trail'|trans }}</a>
        <a href="{{ path('app_demo_deep_s6') }}" class="nowo-ui-aside__link{{ route == 'app_demo_deep_s6' ? ' is-current' : '' }}">{{ 'demo.sidebar.eight_crumbs'|trans }}</a>

        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_admin_col'|trans }}</p>
        <a href="{{ path('app_admin_dashboard') }}" class="nowo-ui-aside__link{{ route == 'app_admin_dashboard' ? ' is-current' : '' }}">{{ 'demo.sidebar.admin'|trans }}</a>
        <a href="{{ path('app_admin_users') }}" class="nowo-ui-aside__link{{ route == 'app_admin_users' ? ' is-current' : '' }}">{{ 'demo.sidebar.users'|trans }}</a>
        <a href="{{ path('app_admin_long_w5') }}" class="nowo-ui-aside__link{{ route in admin_long_routes ? ' is-current' : '' }}">{{ 'demo.sidebar.six_admin_crumbs'|trans }}</a>

        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_twig'|trans }}</p>
        <a href="{{ path('app_demo_breadcrumb_trail') }}" class="nowo-ui-aside__link{{ route == 'app_demo_breadcrumb_trail' ? ' is-current' : '' }}"><code>breadcrumb_trail()</code></a>
        <a href="{{ path('app_demo_custom_template') }}" class="nowo-ui-aside__link{{ route == 'app_demo_custom_template' ? ' is-current' : '' }}">{{ 'demo.sidebar.custom_template'|trans }}</a>

        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.section_edge'|trans }}</p>
        <a href="{{ path('app_demo_no_breadcrumb_match') }}" class="nowo-ui-aside__link{{ route == 'app_demo_no_breadcrumb_match' ? ' is-current' : '' }}">{{ 'demo.sidebar.no_db_row'|trans }}</a>

    {% if dashboard_collections_url %}
        <p class="nowo-ui-aside__label">{{ 'demo.sidebar.admin_block'|trans }}</p>
        <a class="nowo-ui-aside__link" href="{{ dashboard_collections_url }}">{{ 'demo.sidebar.breadcrumb_panel'|trans }}</a>
    {% endif %}
    </nav>
</div>
