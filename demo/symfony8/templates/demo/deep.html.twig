{% extends 'base.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}

{% block title %}{{ 'demo.deep.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.deep.heading'|trans}) }}
{% endblock %}

{% block body %}
    {{ 'demo.deep.body_html'|trans|raw }}
    <h2>{{ 'demo.deep.current_level'|trans }}</h2>
    <p><code>{{ 'demo.deep.step_label'|trans }} {{ level }} / {{ maxLevel }}</code></p>
    <p class="nowo-ui-muted">{{ 'demo.deep.shortcuts'|trans }}</p>
    <nav class="demo-deep-jumps" aria-label="{{ 'demo.deep.jump_aria'|trans }}">
        <a href="{{ path('app_demo_deep') }}">hub</a>
        {% for i in 1..maxLevel %}
            <a href="{{ path('app_demo_deep_s' ~ i) }}">+{{ i }}</a>
        {% endfor %}
    </nav>
{% endblock %}
