{% extends 'base.html.twig' %}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}

{% block title %}{{ 'demo.no_match.title'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'demo.no_match.heading'|trans}) }}
{% endblock %}

{% block body %}
    <p>
        {{ 'demo.no_match.lead_html'|trans|raw }}
    </p>
    <p><a href="{{ path('app_home') }}">{{ 'demo.no_match.back_home'|trans }}</a></p>
{% endblock %}
