{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's signed-in app shell (header, aside, footer) and
    UiKit's default theme (nowo-ui.css from the bundle's own asset package, no CSS framework, no CDN, no token
    overrides). The Breadcrumb Kit dashboard pages render in the same layout (layouts/admin.html.twig, REQ-UI-003). -#}
{% trans_default_domain 'NowoBreadcrumbKitBundle' %}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.base.title_default'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('demo-breadcrumb.css') }}">
    {% block styles %}{% endblock %}
{% endblock %}

{% block nowo_ui_body %}
    {% set dashboard_collections_url = breadcrumb_kit_dashboard_collections_url() %}
    {% set _brand %}
        <a class="nowo-ui-brand" href="{{ path('app_home') }}">{{ 'dashboard.brand'|trans }} <small class="nowo-ui-muted">{{ 'demo.base.brand_sub'|trans }}</small></a>
    {% endset %}
    {% set _header_end %}
        {% if app.request.attributes.get('_route') %}
            {% set rp = app.request.attributes.get('_route_params')|default({}) %}
            <nav aria-label="{{ 'demo.base.language_switch_aria'|trans }}">
                {% for loc in ['en', 'es'] %}
                    <a href="{{ path(app.request.attributes.get('_route'), rp|merge({ _locale: loc })) }}" class="nowo-ui-btn nowo-ui-btn--sm {{ app.request.locale == loc ? 'nowo-ui-btn--primary' : 'nowo-ui-btn--outline' }}">{{ loc|upper }}</a>
                {% endfor %}
            </nav>
        {% endif %}
        {% if dashboard_collections_url %}
            <a href="{{ dashboard_collections_url }}" class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm">{{ 'demo.base.edit_breadcrumbs'|trans }}</a>
        {% endif %}
    {% endset %}
    {% set _aside %}
        {% include '_demo_sidebar.html.twig' %}
        <div class="nowo-ui-aside__inner">
            <p class="nowo-ui-aside__label">{{ 'demo.base.resources_title'|trans }}</p>
            <nav class="nowo-ui-aside__nav" aria-label="{{ 'demo.base.resources_aria'|trans }}">
                <a class="nowo-ui-aside__link" href="https://github.com/nowo-tech/breadcrumb-kit-bundle" rel="noopener noreferrer" target="_blank">{{ 'demo.base.github'|trans }}</a>
                <a class="nowo-ui-aside__link" href="https://packagist.org/packages/nowo-tech/breadcrumb-kit-bundle" rel="noopener noreferrer" target="_blank">{{ 'demo.base.packagist'|trans }}</a>
            </nav>
            <p class="nowo-ui-muted">{{ 'demo.base.resources_note'|trans }}</p>
        </div>
    {% endset %}
    {% set _footer_links = [{label: 'demo.base.footer_home'|trans, href: path('app_home')}] %}
    {% if dashboard_collections_url %}
        {% set _footer_links = _footer_links|merge([{label: 'demo.base.footer_crud'|trans, href: dashboard_collections_url}]) %}
    {% endif %}

    {{ include(nowo_ui_partial('app_shell_open'), {brand_html: _brand, header_end: _header_end, aside_html: _aside, content_width: 'full'}) }}
        <div class="nowo-ui-content" id="nowo-ui-content"{% if nowo_ui_bundle|default(null) %} data-nowo-ui-bundle="{{ nowo_ui_bundle }}"{% endif %}>
            {% block nowo_ui_page_header %}{% endblock %}
            {% block nowo_ui_flashes %}
                {{ include(nowo_ui_partial('flashes', nowo_ui_bundle|default(null)), {bundle: nowo_ui_bundle|default(null)}) }}
            {% endblock %}
            {% block breadcrumb_card %}
                <section class="nowo-ui-card demo-breadcrumb-card">
                    <div class="nowo-ui-card__body">
                        {% block breadcrumb %}
                            {{ breadcrumb_render() }}
                        {% endblock %}
                    </div>
                </section>
            {% endblock %}
            {% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
        </div>
    {{ include(nowo_ui_partial('app_shell_close'), {footer_links: _footer_links}) }}
    {% block nowo_ui_modals %}{% endblock %}
{% endblock %}
